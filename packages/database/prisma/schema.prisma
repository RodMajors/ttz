generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// The existing database uses numeric tinyint values for these fields. The
// first migration will keep the existing table names and numeric mappings.
model User {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name          String?  @db.VarChar(255)
  wxNickname    String?  @map("wx_nickname") @db.VarChar(255)
  guildNickname String?  @map("guild_nickname") @db.VarChar(255)
  openid        String   @unique @db.VarChar(128)
  unionid       String?  @db.VarChar(128)
  avatar        String?  @db.VarChar(255)
  privilege     Int      @default(0) @db.TinyInt
  isApproved    Int      @map("is_approved") @default(0) @db.TinyInt
  status        Int      @default(1) @db.TinyInt
  createdAt     DateTime @map("created_at") @default(now())
  updatedAt     DateTime @map("updated_at") @updatedAt

  characters Character[]
  notificationPreference NotificationPreference?
  groupMemberships GuildGroupMember[]
  activities Activity[]
  signups ActivitySignup[]

  @@map("users")
}

model Character {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId   BigInt @map("user_id") @db.UnsignedBigInt
  name     String @db.VarChar(64)
  realm    String @db.VarChar(64)
  faction  Int?   @db.TinyInt
  spec     Int?
  isMain   Int    @map("is_main") @default(0) @db.TinyInt
  isRetired Int   @map("is_retired") @default(0) @db.TinyInt
  wclId    BigInt? @map("wcl_id") @db.UnsignedBigInt
  itemLevel Int?  @map("item_level")
  user     User   @relation(fields: [userId], references: [id])
  signups  ActivitySignup[]

  @@unique([name, realm], map: "uk_char")
  @@index([userId], map: "idx_user_id")
  @@map("characters")
}

model NotificationPreference {
  userId            BigInt   @id @map("user_id") @db.UnsignedBigInt
  activityPublished Int      @map("activity_published") @default(1) @db.TinyInt
  signupResult      Int      @map("signup_result") @default(1) @db.TinyInt
  beforeTeamUp      Int      @map("before_team_up") @default(1) @db.TinyInt
  activityCancelled Int      @map("activity_cancelled") @default(1) @db.TinyInt
  updatedAt         DateTime @map("updated_at") @updatedAt
  user              User     @relation(fields: [userId], references: [id])
  @@map("notification_preferences")
}

model GuildGroup {
  id          BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name        String @unique @db.VarChar(64)
  code        String @unique @db.VarChar(32)
  description String? @db.VarChar(255)
  isActive    Int    @map("is_active") @default(1) @db.TinyInt
  sort        Int    @default(0)
  members     GuildGroupMember[]
  @@map("guild_groups")
}

model GuildGroupMember {
  id      BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  groupId BigInt @map("group_id") @db.UnsignedBigInt
  userId  BigInt @map("user_id") @db.UnsignedBigInt
  addedBy BigInt? @map("added_by") @db.UnsignedBigInt
  group   GuildGroup @relation(fields: [groupId], references: [id])
  user    User @relation(fields: [userId], references: [id])
  @@unique([groupId, userId], map: "uk_group_member")
  @@map("guild_group_members")
}

model Activity {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name              String   @db.VarChar(64)
  type              BigInt   @db.UnsignedBigInt
  status            Int      @default(0) @db.SmallInt
  creator           BigInt   @db.UnsignedBigInt
  description       String?  @db.LongText
  teamUpAt          DateTime? @map("team_up_at")
  beginAt           DateTime @map("begin_at")
  endAt             DateTime @map("end_at")
  signupDeadline    DateTime? @map("signup_deadline")
  maxPlayers        Int      @map("max_players") @default(20) @db.UnsignedSmallInt
  tankSlots         Int?     @map("tank_slots") @db.UnsignedSmallInt
  healerSlots       Int?     @map("healer_slots") @db.UnsignedSmallInt
  meleeSlots        Int?     @map("melee_slots") @db.UnsignedSmallInt
  rangedSlots       Int?     @map("ranged_slots") @db.UnsignedSmallInt
  durationMinutes   Int      @map("duration_minutes") @default(120) @db.UnsignedSmallInt
  attendanceEnabled Int      @map("attendance_enabled") @default(0) @db.TinyInt
  publishedAt       DateTime? @map("published_at")
  rosterLockedAt    DateTime? @map("roster_locked_at")
  finishedAt        DateTime? @map("finished_at")
  cancelledAt       DateTime? @map("cancelled_at")
  version           Int      @default(1) @db.UnsignedInt
  creatorUser       User     @relation(fields: [creator], references: [id])
  signups           ActivitySignup[]
  @@index([status, beginAt], map: "idx_activities_list")
  @@index([creator, beginAt], map: "idx_activities_creator_time")
  @@map("activities")
}

model ActivitySignup {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  activityId      BigInt   @map("activity_id") @db.UnsignedBigInt
  userId          BigInt   @map("user_id") @db.UnsignedBigInt
  characterId     BigInt   @map("character_id") @db.UnsignedBigInt
  preferredRole   Int?     @map("preferred_role") @db.TinyInt
  preferredSpecId Int?     @map("preferred_spec_id")
  groupNo         Int?     @map("group_no") @db.UnsignedTinyInt
  orderIndex      Int      @map("order_index") @default(0) @db.SmallInt
  status          Int      @default(0) @db.TinyInt
  note            String?  @db.VarChar(255)
  officerNote     String?  @map("officer_note") @db.VarChar(255)
  signedUpAt      DateTime @map("signed_up_at") @default(now())
  confirmedAt     DateTime? @map("confirmed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  handledBy       BigInt?  @map("handled_by") @db.UnsignedBigInt
  handledAt       DateTime? @map("handled_at")
  decisionReason  String?  @map("decision_reason") @db.VarChar(255)
  activity        Activity @relation(fields: [activityId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  character       Character @relation(fields: [characterId], references: [id])
  @@unique([activityId, userId], map: "uk_activity_user")
  @@index([activityId, status], map: "idx_signup_activity_status")
  @@map("activity_signups")
}
