{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**"] },
    "check": { "dependsOn": ["^check"] },
    "dev": { "cache": false, "persistent": true },
    "format": { "dependsOn": ["^format"] },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
