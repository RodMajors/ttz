{
  "name": "ttz-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.5.6"
  },
  "lint-staged": {
    "apps/web/src/**/*.{js,ts,jsx,tsx}": "./node_modules/.bin/biome check --write --no-errors-on-unmatched",
    "apps/miniapp/**/*.ts": "./node_modules/.bin/biome check --write --no-errors-on-unmatched",
    "packages/contracts/**/*.{js,ts}": "./node_modules/.bin/biome check --write --no-errors-on-unmatched"
  }
}
