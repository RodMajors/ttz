<view class="page">
  <view class="eyebrow">TTZ 网页安全登录</view>
  <view class="title">确认登录此浏览器？</view>
  <view class="card">
    <view class="section-title">The Twilight Zone 公会站</view>
    <view class="muted">只有点击确认后，网页端才会建立 HttpOnly 会话。二维码本身不包含你的微信身份或登录凭证。</view>
    <button class="primary-button" disabled="{{submitting || completed}}" bindtap="confirm">确认登录</button>
    <button class="secondary-button" disabled="{{submitting || completed}}" bindtap="cancel">取消</button>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
