{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": { "ignoreUnknown": true, "includes": ["**", "!node_modules", "!.next", "!dist"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "recommended": true, "correctness": { "noUndeclaredDependencies": "off" }, "style": { "useFilenamingConvention": "off" } } },
  "javascript": {
    "formatter": { "quoteStyle": "double", "jsxQuoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  }
}
